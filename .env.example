# ============================================================================
# KIIT Placement Preparation Platform — Environment Configuration Template
# Copy this file to .env and adjust values for your local environment:
#   copy .env.example .env
# ============================================================================

# Database Connection (PostgreSQL 17)
# Replace 'your_password' with your local PostgreSQL postgres user password
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/student_prep_db

# Alternative individual database parameters (used if DATABASE_URL is unset)
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_prep_db

# Secret key for signing student authentication tokens (HMAC-SHA256)
# You can leave this blank in local development or set a custom random string
AUTH_SECRET_KEY=kiit-prep-dev-secret-key-change-in-production

# Google Gemini API Key (Optional)
# If left as placeholder or unset, the platform runs in Database + Document RAG Fallback mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

